+/**
+ * A plate axis appended after a separately declared batch axis (alpha: [j, group])
+ * usually means the shape and the plate describe the same repetition, which
+ * turns a vector into a J x GROUP tensor.
+ */
+function lintAppendedPlateAxis(
+  entity: ModelEntity,
+  plate: PlateDefinition,
+  document: ModelDocument,
+  path: string,
+): Diagnostic[] {
+  const batchAxisIds = entity.valueType.axes.filter((axis) => axis.role === 'batch').map((axis) => axis.axisId);
+  const plateAxisIds = new Set(Object.values(document.plates).map((candidate) => candidate.axisId));
+  const plateAxisIndex = batchAxisIds.indexOf(plate.axisId);
+  const leadingAxisIds = batchAxisIds.slice(0, plateAxisIndex).filter((axisId) => !plateAxisIds.has(axisId));
+  if (plateAxisIndex <= 0 || leadingAxisIds.length === 0) return [];
+  const shape = batchAxisIds.map((axisId) => document.axes[axisId]?.symbol ?? axisId).join(' x ');
+  return [diagnostic({
+    code: 'BC-SHAPE-004',
+    stage: 'shape',
+    severity: 'warning',
+    certainty: 'likely',
+    message: `Plate "${plate.label}" axis "${plate.axisId}" is added after "${leadingAxisIds.join('", "')}", making the batch shape ${shape}. If they are the same repetition, use one axis for the plate.`,
+    path,
+    related: [{ message: 'Plate axis.', path: `/plates/${escapePointer(plate.id)}/axisId` }],
+    blocksHandoff: false,
+  })];
+}
