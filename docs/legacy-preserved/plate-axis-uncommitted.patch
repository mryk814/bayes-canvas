+test('reuses a declared shape axis as the plate axis instead of adding a second batch axis', () => {
+  const compiled = compileCanvas(initialNodes, initialEdges);
+  const { document } = compiled;
+  const batchAxes = (entityId) => document.entities[entityId].valueType.axes.map((axis) => axis.axisId);
+  assert.equal(document.plates.group.axisId, 'j');
+  assert.equal(document.plates.obs.axisId, 'n');
+  assert.deepEqual(batchAxes('alpha'), ['j']);
+  assert.deepEqual(batchAxes('x'), ['n']);
+  assert.deepEqual(batchAxes('y'), ['n']);
+  assert.deepEqual(batchAxes('obs_y'), ['n']);
+  assert.deepEqual(Object.keys(document.axes).sort(), ['j', 'n']);
+  assert.ok(!compiled.semantic.diagnostics.some((item) => item.code === 'BC-SHAPE-004' || item.code === 'BC-PLATE-007'));
+
+  const pkg = buildPortablePackage(document, compiled.layout, compiled.semantic);
+  const preview = previewPortablePackageImport(pkg);
+  const recompiled = compileCanvas(preview.projected.nodes, preview.projected.edges);
+  assert.deepEqual(recompiled.document.plates, document.plates);
+  assert.deepEqual(recompiled.document.axes, document.axes);
+  for (const entityId of ['alpha', 'x', 'group_id', 'mu', 'y']) {
+    assert.deepEqual(recompiled.document.entities[entityId].valueType.axes, document.entities[entityId].valueType.axes);
+  }
+});
+
+test('flags a plate axis appended after a separately declared batch axis', () => {
+  const { document } = compileCanvas(initialNodes, initialEdges);
+  const duplicated = structuredClone(document);
+  duplicated.axes.group = { id: 'group', symbol: 'GROUP', label: 'group', size: { source: 'GROUP' } };
+  duplicated.plates.group.axisId = 'group';
+  duplicated.entities.alpha.valueType.axes = [{ axisId: 'j', role: 'batch' }, { axisId: 'group', role: 'batch' }];
+  const findings = compileModel(duplicated, minimalDistributionRegistry).diagnostics.filter((item) => item.code === 'BC-SHAPE-004');
+  assert.equal(findings.length, 1);
+  assert.equal(findings[0].certainty, 'likely');
+  assert.equal(findings[0].path, '/entities/alpha/valueType/axes');
+  assert.equal(findings[0].blocksHandoff, false);
+
+  const matrix = structuredClone(document);
+  matrix.axes.k = { id: 'k', symbol: 'K', label: 'k', size: { source: 'K' } };
+  matrix.entities.x.valueType.axes = [{ axisId: 'n', role: 'batch' }, { axisId: 'k', role: 'batch' }];
+  assert.ok(!compileModel(matrix, minimalDistributionRegistry).diagnostics.some((item) => item.code === 'BC-SHAPE-004'));
+});
